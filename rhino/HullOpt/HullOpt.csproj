<Project Sdk="Microsoft.NET.Sdk">

  <!-- HullOpt Rhino 7 plug-in. Rhino 7 runs on .NET Framework 4.8. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <TargetExt>.rhp</TargetExt>
    <AssemblyName>HullOpt</AssemblyName>
    <RootNamespace>HullOpt</RootNamespace>
    <Version>0.5.2</Version>
    <Product>HullOpt</Product>
    <Company>Takım-1</Company>
    <Description>Hull form resistance optimisation for Rhino 7</Description>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>portable</DebugType>
    <LangVersion>7.3</LangVersion>
    <!-- RhinoCommon, Eto and Rhino.UI come from the installed Rhino 7 and are not copied to the output. -->
    <RhinoSystemDir Condition="'$(RhinoSystemDir)' == ''">C:\Program Files\Rhino 7\System</RhinoSystemDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RhinoCommon">
      <HintPath>$(RhinoSystemDir)\RhinoCommon.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Eto">
      <HintPath>$(RhinoSystemDir)\Eto.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Rhino.UI">
      <HintPath>$(RhinoSystemDir)\Rhino.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- JSON for the engine protocol: the .NET Framework's own serializer, no extra package. -->
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
